{
  "version": "1.0.0", "created": "2026-05-26",
  "description": "Hardware configuration for local model execution. Tuned for NVIDIA RTX 3070 Ti (8GB VRAM) under Windows + py -3.9.",
  "hardware": {"gpu_model": "NVIDIA RTX 3070 Ti", "vram_gb": 8, "platform": "Windows", "python": "py -3.9"},
  "models": {
    "qwen": {"name": "Qwen 2.5-7B", "quantization": "nf4", "vram_gb": 5.9, "context_tokens": 32000, "persistent_on_gpu": true, "role": "style + redaction"},
    "easyocr": {"name": "EasyOCR", "vram_gb": 0.5, "persistent_on_gpu": false, "load_on_demand": true},
    "sentence_transformer": {"name": "sentence-transformers/all-MiniLM-L6-v2", "vram_gb": 0.1, "persistent_on_gpu": true, "coexists_with": ["qwen"]}
  },
  "policies": {"single_model_at_a_time": true, "empty_cache_between_models": true, "max_concurrent_local_calls": 1, "max_concurrent_cloud_calls": 8},
  "cloud": {"claude": {"context_tokens": 200000, "concurrency": 4}, "gpt": {"context_tokens": 128000, "concurrency": 4}}
}
